# Neon connection string. Use the POOLED endpoint (host contains "-pooler") — on a
# scale-to-zero host each warm container opens its own pool and Neon's free tier caps
# direct connections.
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require

# Max Postgres connections per container. Keep small; real total is this x containers.
PG_POOL_MAX=2

# The AWS SAM stack to pull Lambda/API Gateway CloudWatch metrics from
AWS_REGION=us-east-1
STACK_NAME=medical-scanner

# Port this dashboard listens on
PORT=4300

# HTTP Basic Auth — REQUIRED. The dashboard serves production cost, customer, and
# fraud data, so the server refuses to start without these. Generate a strong password:
#   openssl rand -base64 24
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Set to true ONLY for localhost development. Never on a publicly reachable host.
# DASHBOARD_AUTH_DISABLED=true

# How long a built summary is reused before recomputing. Each miss costs ~15 DB queries
# plus billed CloudWatch GetMetricData calls. Default 300000 (5 minutes).
SUMMARY_CACHE_TTL_MS=300000
